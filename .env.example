# Apple Wallet pass signing — see certs/README.md
#
# Local dev: file paths into the gitignored ./certs folder.
APPLE_WWDR_CERT_PATH=./certs/wwdr.pem
APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=

# Deployed (Vercel etc.): base64-encoded PEM contents instead — the
# certs/ folder isn't part of the deployment bundle. Takes priority over
# the *_PATH vars above when set.
# Generate with: base64 -i certs/wwdr.pem | pbcopy
# APPLE_WWDR_CERT_BASE64=
# APPLE_SIGNER_CERT_BASE64=
# APPLE_SIGNER_KEY_BASE64=

# ---------------------------------------------------------------------------
# Bank iD (OIDC). Leave BANKID_CLIENT_ID unset to keep the mocked verification
# flow, so the demo runs without credentials.
#
# Sandbox issuer (default): https://oidc.sandbox.bankid.cz/
# Production issuer:        https://oidc.bankid.cz/
# Everything else is read from the issuer's OIDC discovery document, so moving
# to production is this one line plus new credentials.
BANKID_ISSUER=https://oidc.sandbox.bankid.cz/
BANKID_CLIENT_ID=
BANKID_CLIENT_SECRET=
BANKID_REDIRECT_URI=http://localhost:3000/api/auth/bankid/callback
# Must match the scopes enabled in the Bank iD developer portal.
# profile.idcards is IDENTIFY PLUS tier in production — free in sandbox.
BANKID_SCOPES=openid profile.name profile.birthdate

# Absolute base URL used to build post-login redirects.
APP_BASE_URL=http://localhost:3000

# Signs the short-lived verification cookie. Min 32 chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
